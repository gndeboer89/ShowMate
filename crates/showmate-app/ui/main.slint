import { LineEdit, TextEdit, ComboBox, CheckBox, ScrollView, Palette } from "std-widgets.slint";
import { DestRow, CommandRow, KeyRow, ToolButton, Field, HeaderCell, Cell } from "common.slint";
import { SettingsWindow } from "settings.slint";

export { DestRow, CommandRow, KeyRow, SettingsWindow }

export struct CueRow {
    number: int,
    name: string,
    kind: string,
    media: string,
    start: string,
    delay: string,
    duration: string,
    output: string,
    status: string,
    active: bool,
    done: bool,
    indent: bool,
    group: bool,
    playhead: bool,
}

export component MainWindow inherits Window {
    in property <string> window-title: "ShowMate";
    title: root.window-title;
    icon: @image-url("../../../assets/icon-256.png");
    preferred-width: 1200px;
    preferred-height: 960px;
    min-width: 960px;
    min-height: 820px;
    background: #0e1420;

    pure function hint(i: int) -> string {
        root.key-hints[i] == "" ? "" : "      " + root.key-hints[i]
    }

    MenuBar {
        Menu {
            title: @tr("Bestand");
            MenuItem { title: @tr("Nieuwe show…") + hint(12); activated => { root.file-new(); } }
            MenuItem { title: @tr("Show openen…") + hint(13); activated => { root.file-open(); } }
            Menu {
                title: @tr("Recente shows");
                for r[i] in root.recent: MenuItem { title: r; activated => { root.open-recent(i); } }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Opslaan") + hint(8); activated => { root.save(); } }
            MenuItem { title: @tr("Opslaan als…") + hint(14); activated => { root.file-save-as(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Afsluiten"); activated => { root.quit-app(); } }
        }
        Menu {
            title: @tr("Bewerken");
            MenuItem { title: @tr("Ongedaan maken") + hint(5); activated => { root.undo(); } }
            MenuItem { title: @tr("Opnieuw") + hint(6); activated => { root.redo(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Cue dupliceren") + hint(7); activated => { root.duplicate-cue(); } }
            MenuItem { title: @tr("Cue verwijderen") + hint(9); activated => { root.remove-cue(); } }
            MenuSeparator {}
            Menu {
                title: @tr("Cue toevoegen");
                MenuItem { title: @tr("Audio-cue"); activated => { root.add-cue("audio"); } }
                MenuItem { title: @tr("Video-cue"); activated => { root.add-cue("video"); } }
                MenuItem { title: @tr("OSC-cue"); activated => { root.add-cue("osc"); } }
                MenuItem { title: @tr("MIDI-cue"); activated => { root.add-cue("midi"); } }
                MenuSeparator {}
                MenuItem { title: @tr("Groep"); activated => { root.add-cue("group"); } }
                MenuItem { title: @tr("Parallel"); activated => { root.add-cue("parallel"); } }
                MenuItem { title: @tr("Loop"); activated => { root.add-cue("loop"); } }
            }
        }
        Menu {
            title: @tr("Show");
            MenuItem { title: "GO" + hint(0); activated => { root.go(); } }
            MenuItem { title: @tr("Pauze / hervat") + hint(1); activated => { root.pause(); } }
            MenuItem { title: "STOP" + hint(2); activated => { root.stop(); } }
            MenuItem { title: "PANIC" + hint(3); activated => { root.panic(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Reset (terug naar het begin)") + hint(4); activated => { root.reset-show(); } }
        }
        Menu {
            title: @tr("Instellingen");
            MenuItem { title: @tr("Algemeen…"); activated => { root.open-settings(0); } }
            MenuItem { title: @tr("Audio…"); activated => { root.open-settings(1); } }
            MenuItem { title: @tr("Video…"); activated => { root.open-settings(2); } }
            MenuItem { title: @tr("OSC…"); activated => { root.open-settings(3); } }
            MenuItem { title: @tr("MIDI…"); activated => { root.open-settings(4); } }
            MenuItem { title: @tr("Sneltoetsen…"); activated => { root.open-settings(5); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("Over ShowMate"); activated => { root.about(); } }
        }
    }

    // Live (elke tick)
    in property <string> timecode: "00:00:00.00";
    in property <string> next-cue: "—";
    in property <string> next-eta: "";
    in property <bool> paused;
    in property <[CueRow]> rows;
    in property <int> selected: -1;
    in property <string> message;

    // Inspector (alleen bij selectiewissel gevuld)
    in property <bool> has-selection;
    in property <bool> locked;
    in property <string> insp-title;
    in-out property <string> insp-name;
    in-out property <string> insp-media;
    in-out property <string> insp-output;
    in-out property <string> insp-notes;
    in-out property <int> insp-start-index;
    in-out property <string> insp-delay;
    in-out property <string> insp-duration;
    in-out property <bool> insp-looping;
    in-out property <string> insp-volume;
    in-out property <string> insp-fade-in;
    in-out property <string> insp-fade-out;
    in property <bool> volume-ok: true;
    in property <bool> fade-in-ok: true;
    in property <bool> fade-out-ok: true;

    // Audio-paneel
    in property <string> wave-commands;
    in property <string> wave-title;
    in property <string> wave-time;
    in property <float> wave-progress;
    in property <float> meter-l;
    in property <float> meter-r;
    in property <string> audio-info;

    // Video-preview
    in property <image> video-preview;
    in property <bool> video-has-preview;
    in property <string> video-title;
    in property <string> video-time;
    in property <string> video-info;

    // Soort-specifiek (OSC / MIDI / video)
    in-out property <string> insp-kind;
    in property <bool> insp-child;
    in-out property <int> insp-group-mode-index;
    in-out property <bool> insp-mute;
    in-out property <int> insp-dest-index;
    in-out property <int> insp-cmd-index;
    in-out property <string> insp-osc-address;
    in-out property <string> insp-osc-args;
    in property <bool> insp-osc-custom: true;
    in property <string> insp-osc-preview;
    in property <string> osc-args-error;
    in-out property <int> insp-midi-kind-index;
    in-out property <string> insp-midi-channel;
    in-out property <string> insp-midi-data1;
    in-out property <string> insp-midi-data2;
    in property <bool> midi-ok: true;
    in property <[string]> dest-names;
    in property <[string]> cmd-names;
    in property <[string]> recent;

    // Instellingenvenster

    in property <bool> delay-ok: true;
    in property <bool> duration-ok: true;

    callback go();
    callback pause();
    callback stop();
    callback select(int);
    callback add-cue(string);
    callback remove-cue();
    callback move-up();
    callback move-down();
    callback save();
    callback edit-name(string);
    callback edit-media(string);
    callback edit-output(string);
    callback edit-notes(string);
    callback edit-start(bool);
    callback edit-delay(string);
    callback edit-duration(string);
    callback edit-looping(bool);
    callback edit-mute(bool);
    callback file-new();
    callback file-open();
    callback file-save-as();
    callback open-recent(int);
    callback browse-media();
    callback key-event(string, bool, bool, bool, bool) -> bool;
    callback edit-group-mode(int);
    callback undo();
    callback redo();
    callback duplicate-cue();
    callback panic();
    callback reset-show();
    callback edit-osc-dest(string);
    callback edit-osc-command(string);
    callback edit-osc-address(string);
    callback edit-osc-args(string);
    callback edit-midi-kind(int);
    callback edit-midi-num(int, string);
    callback test-cue();
    callback open-settings(int);
    callback quit-app();
    callback about();
    in property <[string]> key-hints;
    callback edit-volume(string);
    callback edit-fade-in(string);
    callback edit-fade-out(string);

    init => { Palette.color-scheme = ColorScheme.dark; fs.focus(); }

    fs := FocusScope {
        key-pressed(event) => {
            if (root.key-event(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta)) { return accept; }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Transportbalk
            HorizontalLayout {
                spacing: 12px;
                height: 92px;
                ToolButton { icon: @image-url("icons/play.svg"); text: @tr("GO"); font: 26px; fill: #1c8a2e; horizontal-stretch: 2; clicked => { root.go(); } }
                ToolButton { icon: root.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg"); text: root.paused ? @tr("HERVAT") : @tr("PAUSE"); horizontal-stretch: 1; clicked => { root.pause(); } }
                ToolButton { icon: @image-url("icons/stop.svg"); text: @tr("STOP"); horizontal-stretch: 1; clicked => { root.stop(); } }
                VerticalLayout {
                    width: 120px; spacing: 8px;
                    ToolButton { height: 42px; text: @tr("PANIC"); font: 14px; fill: #7f1d1d; clicked => { root.panic(); } }
                    ToolButton { height: 42px; icon: @image-url("icons/reset.svg"); text: @tr("Reset"); font: 14px; clicked => { root.reset-show(); } }
                }
                Rectangle {
                    horizontal-stretch: 2;
                    border-radius: 8px; border-width: 1px; border-color: #3a4558; background: #151c2a;
                    VerticalLayout {
                        padding: 12px; spacing: 4px; alignment: center;
                        Text { text: @tr("Volgende cue"); color: #9aa6ba; font-size: 13px; }
                        Text { text: root.next-cue; color: white; font-size: 18px; font-weight: 700; overflow: elide; }
                        Text { text: root.next-eta; color: #9aa6ba; font-size: 13px; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 2;
                    border-radius: 8px; border-width: 1px; border-color: #3a4558; background: #151c2a;
                    VerticalLayout {
                        padding: 12px; alignment: center;
                        Text { text: @tr("Tijdcode (show)"); color: #9aa6ba; font-size: 13px; }
                        Text { text: root.timecode; color: white; font-size: 34px; font-weight: 700; }
                    }
                }
            }

            // Gereedschapsbalk
            HorizontalLayout {
                spacing: 8px;
                height: 36px;
                ToolButton { text: @tr("+ Audio"); width: 78px; font: 14px; enabled: !root.locked; clicked => { root.add-cue("audio"); } }
                ToolButton { text: @tr("+ Video"); width: 78px; font: 14px; enabled: !root.locked; clicked => { root.add-cue("video"); } }
                ToolButton { text: @tr("+ OSC"); width: 70px; font: 14px; enabled: !root.locked; clicked => { root.add-cue("osc"); } }
                ToolButton { text: @tr("+ MIDI"); width: 72px; font: 14px; enabled: !root.locked; clicked => { root.add-cue("midi"); } }
                Rectangle { width: 10px; }
                ToolButton { text: @tr("Groep"); width: 72px; font: 14px; enabled: !root.locked; clicked => { root.add-cue("group"); } }
                ToolButton { text: @tr("Parallel"); width: 82px; font: 14px; enabled: !root.locked; clicked => { root.add-cue("parallel"); } }
                ToolButton { text: @tr("Loop"); width: 66px; font: 14px; enabled: !root.locked; clicked => { root.add-cue("loop"); } }
                Rectangle { horizontal-stretch: 1; }
                ToolButton { icon: @image-url("icons/arrow-up.svg"); width: 44px; enabled: root.has-selection && !root.locked; clicked => { root.move-up(); } }
                ToolButton { icon: @image-url("icons/arrow-down.svg"); width: 44px; enabled: root.has-selection && !root.locked; clicked => { root.move-down(); } }
                ToolButton { icon: @image-url("icons/trash.svg"); width: 44px; enabled: root.has-selection && !root.locked; clicked => { root.remove-cue(); } }
            }

            // Cue-lijst
            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                clip: true;
                VerticalLayout {
                    padding: 4px;
                    HorizontalLayout {
                        height: 30px; padding-left: 12px; padding-right: 12px; spacing: 8px;
                        HeaderCell { text: "#"; width: 28px; }
                        HeaderCell { text: @tr("Cue naam"); horizontal-stretch: 1; }
                        HeaderCell { text: @tr("Type"); width: 60px; }
                        HeaderCell { text: @tr("Media"); width: 170px; }
                        HeaderCell { text: @tr("Start"); width: 54px; }
                        HeaderCell { text: @tr("Delay"); width: 74px; }
                        HeaderCell { text: @tr("Duur"); width: 64px; }
                        HeaderCell { text: @tr("Output"); width: 130px; }
                        HeaderCell { text: @tr("Status"); width: 90px; }
                    }
                    ScrollView {
                        VerticalLayout {
                            for row[i] in root.rows: Rectangle {
                                height: 34px;
                                border-radius: 4px;
                                background: root.selected == i ? #1e3a5f : (row.active ? #14532d : (touch.has-hover ? #182133 : transparent));
                                Rectangle { x: 0px; width: 4px; height: parent.height; background: #4ade80; visible: row.playhead; border-radius: 2px; }
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                                    Cell { text: row.number; width: 28px; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Cell { x: row.indent ? 22px : 0px; width: parent.width - self.x; height: parent.height;
                                            text: row.name; font-weight: row.group ? 700 : 400; }
                                    }
                                    Cell { text: row.kind; width: 60px; color: #c5cee0; }
                                    Cell { text: row.media; width: 170px; color: #c5cee0; }
                                    Cell { text: row.start; width: 54px; color: #c5cee0; }
                                    Cell { text: row.delay; width: 74px; color: #c5cee0; }
                                    Cell { text: row.duration; width: 64px; color: #c5cee0; }
                                    Cell { text: row.output; width: 130px; color: #c5cee0; }
                                    Cell {
                                        text: row.status; width: 90px;
                                        color: row.active || row.done ? #4ade80 : #c5cee0;
                                        font-weight: row.active ? 700 : 400;
                                    }
                                }
                                touch := TouchArea { clicked => { root.select(i); fs.focus(); } }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 140px; spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                    HorizontalLayout {
                        padding: 10px; spacing: 14px;
                        VerticalLayout {
                            width: 200px; spacing: 4px;
                            Text { text: root.wave-title == "" ? @tr("Audio") : root.wave-title; color: white; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: root.wave-time; color: #c5cee0; font-size: 13px; overflow: elide; }
                            Text { text: root.audio-info; color: #6b778c; font-size: 11px; overflow: elide; }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #0b101b; border-radius: 4px; clip: true;
                            Path {
                                commands: root.wave-commands;
                                viewbox-width: 512; viewbox-height: 100;
                                width: parent.width; height: parent.height;
                                stroke: #5b7fb5; stroke-width: 1px;
                            }
                            Rectangle {
                                x: 0px; width: parent.width * root.wave-progress; height: parent.height;
                                background: #4ade8022;
                            }
                            Rectangle {
                                x: parent.width * root.wave-progress; width: 2px; height: parent.height;
                                background: #4ade80;
                                visible: root.wave-commands != "";
                            }
                        }
                        VerticalLayout {
                            width: 150px; spacing: 8px; alignment: center;
                            for level[n] in [root.meter-l, root.meter-r]: Rectangle {
                                height: 14px; background: #0b101b; border-radius: 3px; clip: true;
                                Rectangle {
                                    x: 0px; width: parent.width * level; height: parent.height;
                                    background: level > 0.95 ? #ef4444 : (level > 0.85 ? #f59e0b : #22c55e);
                                }
                            }
                            Text { text: "L / R"; color: #6b778c; font-size: 11px; horizontal-alignment: center; }
                        }
                    }
                }
                Rectangle {
                    width: 250px;
                    border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                    VerticalLayout {
                        padding: 8px; spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px; height: 18px;
                            Text { text: root.video-title == "" ? @tr("Video") : root.video-title; color: white; font-size: 13px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                            Text { text: root.video-time; color: #c5cee0; font-size: 12px; }
                        }
                        Rectangle {
                            vertical-stretch: 1; background: #05070c; border-radius: 4px; clip: true;
                            Image { source: root.video-preview; image-fit: contain; width: parent.width; height: parent.height; visible: root.video-has-preview; }
                            Text { text: root.video-has-preview ? "" : (root.video-info != "" ? root.video-info : @tr("geen video actief")); wrap: word-wrap; width: parent.width - 16px; horizontal-alignment: center; color: #6b778c; font-size: 12px; }
                        }
                    }
                }
            }

            // Inspector
            Rectangle {
                height: 236px;
                border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    HorizontalLayout {
                        height: 26px; spacing: 8px;
                        Text {
                            horizontal-stretch: 1; vertical-alignment: center;
                            text: root.has-selection ? root.insp-title : @tr("Selecteer een cue om te bewerken");
                            color: white; font-size: 16px; font-weight: 700; overflow: elide;
                        }
                        if root.has-selection && (root.insp-kind == "osc" || root.insp-kind == "midi"): ToolButton {
                            icon: @image-url("icons/play.svg"); text: @tr("Test"); width: 96px; font: 13px; clicked => { root.test-cue(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        // Kolom 1
                        VerticalLayout {
                            horizontal-stretch: 3; spacing: 6px; alignment: start;
                            Field { label: @tr("Naam");
                                LineEdit { enabled: root.has-selection; text <=> root.insp-name; edited(t) => { root.edit-name(t); } } }
                            if root.insp-kind != "osc" && root.insp-kind != "midi" && root.insp-kind != "group": Field { label: @tr("Media / doel");
                                HorizontalLayout { spacing: 6px;
                                    LineEdit { horizontal-stretch: 1; enabled: root.has-selection; text <=> root.insp-media; edited(t) => { root.edit-media(t); } }
                                    ToolButton { text: @tr("Bladeren…"); width: 104px; height: 32px; font: 13px; enabled: root.has-selection; clicked => { root.browse-media(); } } } }
                            if root.insp-kind != "osc" && root.insp-kind != "midi" && root.insp-kind != "group": Field { label: @tr("Output");
                                LineEdit { enabled: root.has-selection; text <=> root.insp-output; edited(t) => { root.edit-output(t); } } }
                            if root.insp-kind == "group": Field { label: @tr("Soort");
                                ComboBox { model: [@tr("Groep (na elkaar)"), @tr("Parallel (tegelijk)"), @tr("Loop (herhalen)")]; current-index <=> root.insp-group-mode-index;
                                    selected(v) => { root.edit-group-mode(self.current-index); } } }
                            if root.insp-kind == "osc": Field { label: root.insp-dest-index < 0 ? @tr("Bestemming — onbekend") : @tr("Bestemming"); valid: root.insp-dest-index >= 0;
                                ComboBox { model: root.dest-names; current-index <=> root.insp-dest-index; selected(v) => { root.edit-osc-dest(v); } } }
                            if root.insp-kind == "osc": Field { label: root.insp-cmd-index < 0 ? @tr("Commando — onbekend") : @tr("Commando (uit instellingen)"); valid: root.insp-cmd-index >= 0;
                                ComboBox { model: root.cmd-names; current-index <=> root.insp-cmd-index; selected(v) => { root.edit-osc-command(v); } } }
                            if root.insp-kind == "midi": Field { label: @tr("Type");
                                ComboBox { model: ["Note On", "Note Off", "Control Change", "Program Change"]; current-index <=> root.insp-midi-kind-index;
                                    selected(v) => { root.edit-midi-kind(self.current-index); } } }
                            if root.insp-kind == "midi": Field { label: root.midi-ok ? @tr("Kanaal (1–16)") : @tr("Kanaal / data — ongeldig"); valid: root.midi-ok;
                                LineEdit { text <=> root.insp-midi-channel; input-type: number; edited(t) => { root.edit-midi-num(0, t); } } }
                        }
                        // Kolom 2
                        VerticalLayout {
                            horizontal-stretch: 2; spacing: 6px; alignment: start;
                            if !root.insp-child: Field { label: @tr("Start");
                                ComboBox { enabled: root.has-selection; model: ["GO", "Auto"]; current-index <=> root.insp-start-index;
                                    selected(v) => { root.edit-start(v == "Auto"); } } }
                            Field { label: root.delay-ok ? @tr("Delay (s of mm:ss)") : @tr("Delay — ongeldig"); valid: root.delay-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-delay; edited(t) => { root.edit-delay(t); } } }
                            if root.insp-kind != "osc" && root.insp-kind != "midi": Field { label: root.duration-ok ? (root.insp-kind == "group" ? @tr("Duur (maximum, leeg = tot klaar)") : @tr("Duur (leeg = onbepaald)")) : @tr("Duur — ongeldig"); valid: root.duration-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-duration; edited(t) => { root.edit-duration(t); } } }
                        }
                        // Kolom 3
                        VerticalLayout {
                            horizontal-stretch: 2; spacing: 6px; alignment: start;
                            if root.insp-kind == "audio" || root.insp-kind == "video": Field { label: root.volume-ok ? @tr("Volume (dB)") : @tr("Volume — ongeldig (−60…+12)"); valid: root.volume-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-volume; placeholder-text: "0"; edited(t) => { root.edit-volume(t); } } }
                            if root.insp-kind == "audio" || root.insp-kind == "video": Field { label: root.fade-in-ok ? @tr("Fade in (s)") : @tr("Fade in — ongeldig"); valid: root.fade-in-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-fade-in; edited(t) => { root.edit-fade-in(t); } } }
                            if root.insp-kind == "audio" || root.insp-kind == "video": Field { label: root.fade-out-ok ? @tr("Fade out (s)") : @tr("Fade out — ongeldig"); valid: root.fade-out-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-fade-out; edited(t) => { root.edit-fade-out(t); } } }
                            if root.insp-kind == "osc": Field { label: @tr("OSC-adres");
                                LineEdit { enabled: root.insp-osc-custom; text <=> root.insp-osc-address; placeholder-text: "/pad/naar/iets"; edited(t) => { root.edit-osc-address(t); } } }
                            if root.insp-kind == "osc": Field { label: root.osc-args-error == "" ? @tr("Argumenten (bv. f:0.7 5 true)") : @tr("Argumenten — ") + root.osc-args-error; valid: root.osc-args-error == "";
                                LineEdit { enabled: root.insp-osc-custom; text <=> root.insp-osc-args; edited(t) => { root.edit-osc-args(t); } } }
                            if root.insp-kind == "osc": Text { text: root.insp-osc-preview == "" ? "" : @tr("Verstuurt: ") + root.insp-osc-preview; color: #6b778c; font-size: 11px; overflow: elide; }
                            if root.insp-kind == "midi": Field { label: root.insp-midi-kind-index == 0 || root.insp-midi-kind-index == 1 ? @tr("Noot (0–127)") : (root.insp-midi-kind-index == 2 ? @tr("Controller (0–127)") : @tr("Programma (0–127)"));
                                LineEdit { text <=> root.insp-midi-data1; input-type: number; edited(t) => { root.edit-midi-num(1, t); } } }
                            if root.insp-kind == "midi" && root.insp-midi-kind-index != 3: Field { label: root.insp-midi-kind-index == 2 ? @tr("Waarde (0–127)") : @tr("Snelheid (0–127)");
                                LineEdit { text <=> root.insp-midi-data2; input-type: number; edited(t) => { root.edit-midi-num(2, t); } } }
                        }
                        // Kolom 4
                        VerticalLayout {
                            horizontal-stretch: 3; spacing: 6px; alignment: start;
                            if root.insp-kind == "audio" || root.insp-kind == "video": CheckBox { enabled: root.has-selection; text: @tr("Herhaal (loop)"); checked <=> root.insp-looping;
                                toggled => { root.edit-looping(self.checked); } }
                            if root.insp-kind == "video": CheckBox { enabled: root.has-selection; text: @tr("Geluid van video dempen"); checked <=> root.insp-mute;
                                toggled => { root.edit-mute(self.checked); } }
                            Field { label: @tr("Notities");
                                TextEdit { min-height: 100px; enabled: root.has-selection; text <=> root.insp-notes; edited(t) => { root.edit-notes(t); } } }
                        }
                    }
                }
            }
            Text { height: 18px; text: root.message; color: #fbbf24; font-size: 13px; vertical-alignment: center; overflow: elide; }
        }
    }
}
