import { LineEdit, TextEdit, ComboBox, CheckBox, ScrollView, Palette } from "std-widgets.slint";

export struct DestRow {
    name: string,
    host: string,
    port: string,
}

export struct CommandRow {
    name: string,
    address: string,
    args: string,
}

export struct CueRow {
    number: int,
    name: string,
    kind: string,
    media: string,
    start: string,
    delay: string,
    duration: string,
    output: string,
    status: string,
    active: bool,
    done: bool,
}

component ToolButton inherits Rectangle {
    in property <string> text;
    in property <color> fill: #232b3a;
    in property <length> font: 15px;
    in property <bool> enabled: true;
    callback clicked();
    border-radius: 8px;
    border-width: 1px;
    border-color: #3a4558;
    opacity: enabled ? 1 : 0.4;
    background: touch.has-hover && enabled ? fill.brighter(0.15) : fill;
    Text { text: root.text; color: white; font-size: root.font; font-weight: 600; }
    touch := TouchArea { clicked => { if (root.enabled) { root.clicked(); } } }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <bool> valid: true;
    spacing: 3px;
    Text { text: root.label; color: root.valid ? #9aa6ba : #f87171; font-size: 12px; }
    @children
}

component HeaderCell inherits Text {
    horizontal-alignment: left;
    min-width: 0px;
    color: #9aa6ba;
    font-size: 13px;
    vertical-alignment: center;
}

component Cell inherits Text {
    horizontal-alignment: left;
    min-width: 0px;
    color: white;
    font-size: 14px;
    vertical-alignment: center;
    overflow: elide;
}

export component MainWindow inherits Window {
    in property <string> window-title: "ShowMate";
    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 960px;
    min-width: 960px;
    min-height: 820px;
    background: #0e1420;

    // Live (elke tick)
    in property <string> timecode: "00:00:00.00";
    in property <string> next-cue: "—";
    in property <string> next-eta: "";
    in property <bool> paused;
    in property <[CueRow]> rows;
    in property <int> selected: -1;
    in property <string> message;

    // Inspector (alleen bij selectiewissel gevuld)
    in property <bool> has-selection;
    in property <bool> locked;
    in property <string> insp-title;
    in-out property <string> insp-name;
    in-out property <string> insp-media;
    in-out property <string> insp-output;
    in-out property <string> insp-notes;
    in-out property <int> insp-start-index;
    in-out property <string> insp-delay;
    in-out property <string> insp-duration;
    in-out property <bool> insp-looping;
    in-out property <string> insp-volume;
    in-out property <string> insp-fade-in;
    in-out property <string> insp-fade-out;
    in property <bool> volume-ok: true;
    in property <bool> fade-in-ok: true;
    in property <bool> fade-out-ok: true;

    // Audio-paneel
    in property <string> wave-commands;
    in property <string> wave-title;
    in property <string> wave-time;
    in property <float> wave-progress;
    in property <float> meter-l;
    in property <float> meter-r;
    in property <string> audio-info;

    // Video-preview
    in property <image> video-preview;
    in property <bool> video-has-preview;
    in property <string> video-title;
    in property <string> video-time;
    in property <string> video-info;

    // Soort-specifiek (OSC / MIDI / video)
    in-out property <string> insp-kind;
    in-out property <bool> insp-mute;
    in-out property <int> insp-dest-index;
    in-out property <int> insp-cmd-index;
    in-out property <string> insp-osc-address;
    in-out property <string> insp-osc-args;
    in property <bool> insp-osc-custom: true;
    in property <string> insp-osc-preview;
    in property <string> osc-args-error;
    in-out property <int> insp-midi-kind-index;
    in-out property <string> insp-midi-channel;
    in-out property <string> insp-midi-data1;
    in-out property <string> insp-midi-data2;
    in property <bool> midi-ok: true;
    in property <[string]> dest-names;
    in property <[string]> cmd-names;

    // Instellingenvenster
    in property <bool> settings-open;
    in property <[DestRow]> dests;
    in property <[CommandRow]> cmds;
    in property <[string]> midi-ports;
    in-out property <int> midi-index;
    in property <string> midi-status;
    in property <string> settings-note;

    in property <bool> delay-ok: true;
    in property <bool> duration-ok: true;

    callback go();
    callback pause();
    callback stop();
    callback select(int);
    callback add-cue(string);
    callback remove-cue();
    callback move-up();
    callback move-down();
    callback save();
    callback edit-name(string);
    callback edit-media(string);
    callback edit-output(string);
    callback edit-notes(string);
    callback edit-start(bool);
    callback edit-delay(string);
    callback edit-duration(string);
    callback edit-looping(bool);
    callback edit-mute(bool);
    callback edit-osc-dest(string);
    callback edit-osc-command(string);
    callback edit-osc-address(string);
    callback edit-osc-args(string);
    callback edit-midi-kind(int);
    callback edit-midi-num(int, string);
    callback test-cue();
    callback open-settings();
    callback close-settings();
    callback dest-edited(int, int, string);
    callback dest-add();
    callback dest-remove(int);
    callback cmd-edited(int, int, string);
    callback cmd-add();
    callback cmd-remove(int);
    callback midi-selected(string);
    callback midi-refresh();
    callback edit-volume(string);
    callback edit-fade-in(string);
    callback edit-fade-out(string);

    init => { Palette.color-scheme = ColorScheme.dark; fs.focus(); }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "s") { root.save(); return accept; }
            if (event.text == " ") { root.go(); return accept; }
            if (event.text == "p") { root.pause(); return accept; }
            if (event.text == Key.Escape) { root.stop(); return accept; }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Transportbalk
            HorizontalLayout {
                spacing: 12px;
                height: 92px;
                ToolButton { text: "▶  GO"; font: 26px; fill: #1c8a2e; horizontal-stretch: 2; clicked => { root.go(); } }
                ToolButton { text: root.paused ? "▶  HERVAT" : "⏸  PAUSE"; horizontal-stretch: 1; clicked => { root.pause(); } }
                ToolButton { text: "■  STOP"; horizontal-stretch: 1; clicked => { root.stop(); } }
                Rectangle {
                    horizontal-stretch: 2;
                    border-radius: 8px; border-width: 1px; border-color: #3a4558; background: #151c2a;
                    VerticalLayout {
                        padding: 12px; spacing: 4px; alignment: center;
                        Text { text: "Volgende cue"; color: #9aa6ba; font-size: 13px; }
                        Text { text: root.next-cue; color: white; font-size: 18px; font-weight: 700; overflow: elide; }
                        Text { text: root.next-eta; color: #9aa6ba; font-size: 13px; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 2;
                    border-radius: 8px; border-width: 1px; border-color: #3a4558; background: #151c2a;
                    VerticalLayout {
                        padding: 12px; alignment: center;
                        Text { text: "Tijdcode (show)"; color: #9aa6ba; font-size: 13px; }
                        Text { text: root.timecode; color: white; font-size: 34px; font-weight: 700; }
                    }
                }
            }

            // Gereedschapsbalk
            HorizontalLayout {
                spacing: 8px;
                height: 36px;
                ToolButton { text: "+ Audio"; width: 92px; enabled: !root.locked; clicked => { root.add-cue("audio"); } }
                ToolButton { text: "+ Video"; width: 92px; enabled: !root.locked; clicked => { root.add-cue("video"); } }
                ToolButton { text: "+ OSC"; width: 80px; enabled: !root.locked; clicked => { root.add-cue("osc"); } }
                ToolButton { text: "+ MIDI"; width: 80px; enabled: !root.locked; clicked => { root.add-cue("midi"); } }
                Text { text: root.message; color: #fbbf24; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                ToolButton { text: "⚙ Instellingen"; width: 140px; clicked => { root.open-settings(); } }
                ToolButton { text: "💾 Opslaan"; width: 110px; clicked => { root.save(); } }
                ToolButton { text: "↑"; width: 44px; enabled: root.has-selection && !root.locked; clicked => { root.move-up(); } }
                ToolButton { text: "↓"; width: 44px; enabled: root.has-selection && !root.locked; clicked => { root.move-down(); } }
                ToolButton { text: "🗑"; width: 44px; enabled: root.has-selection && !root.locked; clicked => { root.remove-cue(); } }
            }

            // Cue-lijst
            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                clip: true;
                VerticalLayout {
                    padding: 4px;
                    HorizontalLayout {
                        height: 30px; padding-left: 12px; padding-right: 12px; spacing: 8px;
                        HeaderCell { text: "#"; width: 28px; }
                        HeaderCell { text: "Cue naam"; horizontal-stretch: 1; }
                        HeaderCell { text: "Type"; width: 60px; }
                        HeaderCell { text: "Media"; width: 170px; }
                        HeaderCell { text: "Start"; width: 54px; }
                        HeaderCell { text: "Delay"; width: 74px; }
                        HeaderCell { text: "Duur"; width: 64px; }
                        HeaderCell { text: "Output"; width: 130px; }
                        HeaderCell { text: "Status"; width: 90px; }
                    }
                    ScrollView {
                        VerticalLayout {
                            for row[i] in root.rows: Rectangle {
                                height: 34px;
                                border-radius: 4px;
                                background: root.selected == i ? #1e3a5f : (row.active ? #14532d : (touch.has-hover ? #182133 : transparent));
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                                    Cell { text: row.number; width: 28px; }
                                    Cell { text: row.name; horizontal-stretch: 1; }
                                    Cell { text: row.kind; width: 60px; color: #c5cee0; }
                                    Cell { text: row.media; width: 170px; color: #c5cee0; }
                                    Cell { text: row.start; width: 54px; color: #c5cee0; }
                                    Cell { text: row.delay; width: 74px; color: #c5cee0; }
                                    Cell { text: row.duration; width: 64px; color: #c5cee0; }
                                    Cell { text: row.output; width: 130px; color: #c5cee0; }
                                    Cell {
                                        text: row.status; width: 90px;
                                        color: row.active || row.done ? #4ade80 : #c5cee0;
                                        font-weight: row.active ? 700 : 400;
                                    }
                                }
                                touch := TouchArea { clicked => { root.select(i); fs.focus(); } }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 140px; spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                    HorizontalLayout {
                        padding: 10px; spacing: 14px;
                        VerticalLayout {
                            width: 200px; spacing: 4px;
                            Text { text: root.wave-title == "" ? "Audio" : root.wave-title; color: white; font-size: 14px; font-weight: 700; overflow: elide; }
                            Text { text: root.wave-time; color: #c5cee0; font-size: 13px; overflow: elide; }
                            Text { text: root.audio-info; color: #6b778c; font-size: 11px; overflow: elide; }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #0b101b; border-radius: 4px; clip: true;
                            Path {
                                commands: root.wave-commands;
                                viewbox-width: 512; viewbox-height: 100;
                                width: parent.width; height: parent.height;
                                stroke: #5b7fb5; stroke-width: 1px;
                            }
                            Rectangle {
                                x: 0px; width: parent.width * root.wave-progress; height: parent.height;
                                background: #4ade8022;
                            }
                            Rectangle {
                                x: parent.width * root.wave-progress; width: 2px; height: parent.height;
                                background: #4ade80;
                                visible: root.wave-commands != "";
                            }
                        }
                        VerticalLayout {
                            width: 150px; spacing: 8px; alignment: center;
                            for level[n] in [root.meter-l, root.meter-r]: Rectangle {
                                height: 14px; background: #0b101b; border-radius: 3px; clip: true;
                                Rectangle {
                                    x: 0px; width: parent.width * level; height: parent.height;
                                    background: level > 0.95 ? #ef4444 : (level > 0.85 ? #f59e0b : #22c55e);
                                }
                            }
                            Text { text: "L / R"; color: #6b778c; font-size: 11px; horizontal-alignment: center; }
                        }
                    }
                }
                Rectangle {
                    width: 250px;
                    border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                    VerticalLayout {
                        padding: 8px; spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px; height: 18px;
                            Text { text: root.video-title == "" ? "Video" : root.video-title; color: white; font-size: 13px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                            Text { text: root.video-time; color: #c5cee0; font-size: 12px; }
                        }
                        Rectangle {
                            vertical-stretch: 1; background: #05070c; border-radius: 4px; clip: true;
                            Image { source: root.video-preview; image-fit: contain; width: parent.width; height: parent.height; visible: root.video-has-preview; }
                            Text { text: root.video-has-preview ? "" : (root.video-info != "" ? root.video-info : "geen video actief"); wrap: word-wrap; width: parent.width - 16px; horizontal-alignment: center; color: #6b778c; font-size: 12px; }
                        }
                    }
                }
            }

            // Inspector
            Rectangle {
                height: 236px;
                border-radius: 8px; border-width: 1px; border-color: #2a3344; background: #111826;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    HorizontalLayout {
                        height: 26px; spacing: 8px;
                        Text {
                            horizontal-stretch: 1; vertical-alignment: center;
                            text: root.has-selection ? root.insp-title : "Selecteer een cue om te bewerken";
                            color: white; font-size: 16px; font-weight: 700; overflow: elide;
                        }
                        if root.has-selection && (root.insp-kind == "osc" || root.insp-kind == "midi"): ToolButton {
                            text: "▶ Test"; width: 90px; font: 13px; clicked => { root.test-cue(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        // Kolom 1
                        VerticalLayout {
                            horizontal-stretch: 3; spacing: 6px; alignment: start;
                            Field { label: "Naam";
                                LineEdit { enabled: root.has-selection; text <=> root.insp-name; edited(t) => { root.edit-name(t); } } }
                            if root.insp-kind != "osc" && root.insp-kind != "midi": Field { label: "Media / doel";
                                LineEdit { enabled: root.has-selection; text <=> root.insp-media; edited(t) => { root.edit-media(t); } } }
                            if root.insp-kind != "osc" && root.insp-kind != "midi": Field { label: "Output";
                                LineEdit { enabled: root.has-selection; text <=> root.insp-output; edited(t) => { root.edit-output(t); } } }
                            if root.insp-kind == "osc": Field { label: root.insp-dest-index < 0 ? "Bestemming — onbekend" : "Bestemming"; valid: root.insp-dest-index >= 0;
                                ComboBox { model: root.dest-names; current-index <=> root.insp-dest-index; selected(v) => { root.edit-osc-dest(v); } } }
                            if root.insp-kind == "osc": Field { label: root.insp-cmd-index < 0 ? "Commando — onbekend" : "Commando (uit instellingen)"; valid: root.insp-cmd-index >= 0;
                                ComboBox { model: root.cmd-names; current-index <=> root.insp-cmd-index; selected(v) => { root.edit-osc-command(v); } } }
                            if root.insp-kind == "midi": Field { label: "Type";
                                ComboBox { model: ["Note On", "Note Off", "Control Change", "Program Change"]; current-index <=> root.insp-midi-kind-index;
                                    selected(v) => { root.edit-midi-kind(self.current-index); } } }
                            if root.insp-kind == "midi": Field { label: root.midi-ok ? "Kanaal (1–16)" : "Kanaal / data — ongeldig"; valid: root.midi-ok;
                                LineEdit { text <=> root.insp-midi-channel; input-type: number; edited(t) => { root.edit-midi-num(0, t); } } }
                        }
                        // Kolom 2
                        VerticalLayout {
                            horizontal-stretch: 2; spacing: 6px; alignment: start;
                            Field { label: "Start";
                                ComboBox { enabled: root.has-selection; model: ["GO", "Auto"]; current-index <=> root.insp-start-index;
                                    selected(v) => { root.edit-start(v == "Auto"); } } }
                            Field { label: root.delay-ok ? "Delay (s of mm:ss)" : "Delay — ongeldig"; valid: root.delay-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-delay; edited(t) => { root.edit-delay(t); } } }
                            if root.insp-kind != "osc" && root.insp-kind != "midi": Field { label: root.duration-ok ? "Duur (leeg = onbepaald)" : "Duur — ongeldig"; valid: root.duration-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-duration; edited(t) => { root.edit-duration(t); } } }
                        }
                        // Kolom 3
                        VerticalLayout {
                            horizontal-stretch: 2; spacing: 6px; alignment: start;
                            if root.insp-kind == "audio" || root.insp-kind == "video": Field { label: root.volume-ok ? "Volume (dB)" : "Volume — ongeldig (−60…+12)"; valid: root.volume-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-volume; placeholder-text: "0"; edited(t) => { root.edit-volume(t); } } }
                            if root.insp-kind == "audio" || root.insp-kind == "video": Field { label: root.fade-in-ok ? "Fade in (s)" : "Fade in — ongeldig"; valid: root.fade-in-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-fade-in; edited(t) => { root.edit-fade-in(t); } } }
                            if root.insp-kind == "audio" || root.insp-kind == "video": Field { label: root.fade-out-ok ? "Fade out (s)" : "Fade out — ongeldig"; valid: root.fade-out-ok;
                                LineEdit { enabled: root.has-selection; text <=> root.insp-fade-out; edited(t) => { root.edit-fade-out(t); } } }
                            if root.insp-kind == "osc": Field { label: "OSC-adres";
                                LineEdit { enabled: root.insp-osc-custom; text <=> root.insp-osc-address; placeholder-text: "/pad/naar/iets"; edited(t) => { root.edit-osc-address(t); } } }
                            if root.insp-kind == "osc": Field { label: root.osc-args-error == "" ? "Argumenten (bv. f:0.7 5 true)" : "Argumenten — " + root.osc-args-error; valid: root.osc-args-error == "";
                                LineEdit { enabled: root.insp-osc-custom; text <=> root.insp-osc-args; edited(t) => { root.edit-osc-args(t); } } }
                            if root.insp-kind == "osc": Text { text: root.insp-osc-preview == "" ? "" : "Verstuurt: " + root.insp-osc-preview; color: #6b778c; font-size: 11px; overflow: elide; }
                            if root.insp-kind == "midi": Field { label: root.insp-midi-kind-index == 0 || root.insp-midi-kind-index == 1 ? "Noot (0–127)" : (root.insp-midi-kind-index == 2 ? "Controller (0–127)" : "Programma (0–127)");
                                LineEdit { text <=> root.insp-midi-data1; input-type: number; edited(t) => { root.edit-midi-num(1, t); } } }
                            if root.insp-kind == "midi" && root.insp-midi-kind-index != 3: Field { label: root.insp-midi-kind-index == 2 ? "Waarde (0–127)" : "Snelheid (0–127)";
                                LineEdit { text <=> root.insp-midi-data2; input-type: number; edited(t) => { root.edit-midi-num(2, t); } } }
                        }
                        // Kolom 4
                        VerticalLayout {
                            horizontal-stretch: 3; spacing: 6px; alignment: start;
                            if root.insp-kind == "audio" || root.insp-kind == "video": CheckBox { enabled: root.has-selection; text: "Herhaal (loop)"; checked <=> root.insp-looping;
                                toggled => { root.edit-looping(self.checked); } }
                            if root.insp-kind == "video": CheckBox { enabled: root.has-selection; text: "Geluid van video dempen"; checked <=> root.insp-mute;
                                toggled => { root.edit-mute(self.checked); } }
                            Field { label: "Notities";
                                TextEdit { min-height: 100px; enabled: root.has-selection; text <=> root.insp-notes; edited(t) => { root.edit-notes(t); } } }
                        }
                    }
                }
            }
        }
    }

    // Instellingenvenster (over alles heen)
    if root.settings-open: Rectangle {
        background: #000000b0;
        TouchArea { }
        Rectangle {
            width: min(960px, parent.width - 40px);
            height: min(640px, parent.height - 40px);
            border-radius: 10px; border-width: 1px; border-color: #3a4558; background: #111826;
            VerticalLayout {
                padding: 18px; spacing: 10px;
                Text { text: "Instellingen"; color: white; font-size: 20px; font-weight: 700; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px; alignment: start;
                        Text { text: "OSC-bestemmingen (bv. lichttafel)"; color: #c5cee0; font-size: 15px; font-weight: 700; }
                        HorizontalLayout { spacing: 8px; padding-right: 48px; height: 22px;
                            HeaderCell { text: "Naam"; width: 180px; }
                            HeaderCell { text: "IP-adres of hostnaam"; horizontal-stretch: 1; }
                            HeaderCell { text: "Poort"; width: 90px; } }
                        for d[i] in root.dests: HorizontalLayout {
                            spacing: 8px; height: 34px;
                            LineEdit { width: 180px; text: d.name; edited(t) => { root.dest-edited(i, 0, t); } }
                            LineEdit { horizontal-stretch: 1; text: d.host; edited(t) => { root.dest-edited(i, 1, t); } }
                            LineEdit { width: 90px; text: d.port; input-type: number; edited(t) => { root.dest-edited(i, 2, t); } }
                            ToolButton { width: 40px; text: "✕"; font: 14px; clicked => { root.dest-remove(i); } }
                        }
                        HorizontalLayout { alignment: start; ToolButton { text: "+ Bestemming"; width: 150px; height: 32px; font: 13px; clicked => { root.dest-add(); } } }

                        Text { text: "OSC-commando's (adres en argumenten, te kiezen per cue)"; color: #c5cee0; font-size: 15px; font-weight: 700; }
                        HorizontalLayout { spacing: 8px; padding-right: 48px; height: 22px;
                            HeaderCell { text: "Naam"; width: 180px; }
                            HeaderCell { text: "OSC-adres"; horizontal-stretch: 1; }
                            HeaderCell { text: "Argumenten"; width: 200px; } }
                        for c[i] in root.cmds: HorizontalLayout {
                            spacing: 8px; height: 34px;
                            LineEdit { width: 180px; text: c.name; edited(t) => { root.cmd-edited(i, 0, t); } }
                            LineEdit { horizontal-stretch: 1; text: c.address; placeholder-text: "/eos/cue/1/fire"; edited(t) => { root.cmd-edited(i, 1, t); } }
                            LineEdit { width: 200px; text: c.args; placeholder-text: "f:0.7"; edited(t) => { root.cmd-edited(i, 2, t); } }
                            ToolButton { width: 40px; text: "✕"; font: 14px; clicked => { root.cmd-remove(i); } }
                        }
                        HorizontalLayout { alignment: start; ToolButton { text: "+ Commando"; width: 150px; height: 32px; font: 13px; clicked => { root.cmd-add(); } } }

                        Text { text: "MIDI-uitgang"; color: #c5cee0; font-size: 15px; font-weight: 700; }
                        HorizontalLayout { spacing: 8px; height: 34px;
                            ComboBox { width: 320px; model: root.midi-ports; current-index <=> root.midi-index; selected(v) => { root.midi-selected(v); } }
                            ToolButton { width: 110px; text: "Vernieuwen"; font: 13px; clicked => { root.midi-refresh(); } }
                            Text { text: root.midi-status; color: #9aa6ba; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px; height: 38px;
                    Text { text: root.settings-note; color: #fbbf24; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    ToolButton { text: "Opslaan en sluiten"; width: 190px; fill: #1c8a2e; clicked => { root.close-settings(); } }
                }
            }
        }
    }
}
